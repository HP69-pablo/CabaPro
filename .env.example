# Database (PostgreSQL - Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cabapro?schema=public"

# Authentication & Session Security (Min 32 characters)
AUTH_SECRET="caba-pro-super-secret-key-32-chars-minimum-auth-token-12345"

# AES-256-GCM Encryption Key for Payout Details at Rest (Min 32 characters)
ENCRYPTION_KEY="caba-pro-encryption-key-for-payout-accounts-32-chars-long"

# Secret Pepper for 6-Digit Delivery Code Hashing (Min 16 characters)
DELIVERY_CODE_PEPPER="caba-delivery-code-pepper-secret-2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode Enabled (Simulated payments, fast-forwarding, instant bureau wire)
DEMO_MODE=true

# Environment
NODE_ENV="development"
